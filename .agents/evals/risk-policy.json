{
  "schemaVersion": "openforge-agent-risk-policy/v1",
  "defaultRisk": "low",
  "traceRequiredAt": ["high"],
  "tracePathPrefix": ".agents/evals/traces/",
  "rules": [
    {"risk": "high", "pattern": ".github/workflows/**", "reason": "CI and release behavior"},
    {"risk": "high", "pattern": "scripts/ci/**", "reason": "CI governance and enforcement logic"},
    {"risk": "high", "pattern": "scripts/airgap/**", "reason": "air-gap supply-chain and install inputs"},
    {"risk": "high", "pattern": "scripts/install/**", "reason": "cluster mutation and bootstrap"},
    {"risk": "high", "pattern": "scripts/security/**", "reason": "security enforcement"},
    {"risk": "high", "pattern": "gitops/**", "reason": "desired-state deployment contract"},
    {"risk": "high", "pattern": "VERSIONS*", "reason": "platform version source of truth"},
    {"risk": "high", "pattern": ".agents/**", "reason": "agent policy or evidence contract"}
  ],
  "dependencyBumpExemption": {
    "_comment": "Narrow, fail-closed carve-out so Dependabot pin bumps (e.g. ruby/setup-ruby 1.321.0->1.324.0) satisfy the high-risk trace requirement via a standing trace instead of an impossible per-PR trace. Restricted to .github/workflows/**: dependabot.yml only watches the github-actions ecosystem here (no package manifest/lockfile in this repo to bump). Any human author, unverified commit, non-uses: workflow edit, or file outside allowedPathPatterns still requires a changed trace.",
    "trustedAuthors": ["dependabot[bot]"],
    "standingTrace": ".agents/evals/traces/dependency-bump.json",
    "allowedPathPatterns": [".github/workflows/*.yml", ".github/workflows/*.yaml"],
    "pinOnlyLineRe": "^\\s*-?\\s*uses:\\s*(?P<ref>\\S+)(?:\\s*#.*)?$"
  }
}
