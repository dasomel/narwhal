{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dasomel.github.io/narwhal/schemas/event-envelope-1.0.schema.json",
  "title": "Narwhal canonical event envelope",
  "description": "Portal-compatible envelope for versioned Narwhal control-plane events.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "schema_version",
    "occurred_at",
    "received_at",
    "correlation_id",
    "causation_id",
    "request_id",
    "operation_id",
    "incident_id",
    "evidence_id",
    "trace_id",
    "span_id",
    "source",
    "source_version",
    "actor",
    "resource",
    "idempotency_key",
    "source_event_id",
    "data"
  ],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": { "type": "string" },
    "event_version": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "received_at": { "type": "string", "format": "date-time" },
    "correlation_id": { "type": "string" },
    "causation_id": { "type": ["string", "null"] },
    "request_id": { "type": ["string", "null"] },
    "operation_id": { "type": ["string", "null"] },
    "incident_id": { "type": ["string", "null"] },
    "evidence_id": { "type": ["string", "null"] },
    "trace_id": { "type": ["string", "null"] },
    "span_id": { "type": ["string", "null"] },
    "source": { "type": "string" },
    "source_version": { "type": ["string", "null"] },
    "actor": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["user", "system", "service"] },
        "displayName": { "type": "string" }
      },
      "additionalProperties": true
    },
    "resource": {
      "type": ["object", "null"],
      "properties": {
        "cluster": { "type": "string" },
        "namespace": { "type": "string" },
        "kind": { "type": "string" },
        "name": { "type": "string" },
        "workload": { "type": "string" }
      },
      "additionalProperties": true
    },
    "idempotency_key": { "type": ["string", "null"] },
    "source_event_id": { "type": ["string", "null"] },
    "data": {}
  },
  "additionalProperties": true
}
