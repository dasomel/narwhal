{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dasomel.github.io/narwhal/schemas/upgrade-bundle-1.0.schema.json",
  "title": "Narwhal air-gap upgrade bundle manifest",
  "description": "Canonical schema for offline upgrade bundle manifests, promotion stage tracking, and artifact provenance in Narwhal IDP.",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "target_version",
    "created_at",
    "promotion_stage",
    "compatibility_matrix_ref",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "target_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "promotion_stage": {
      "type": "string",
      "enum": ["dev", "staged", "production"]
    },
    "compatibility_matrix_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Reference path, URL, or schema id for component compatibility matrix (e.g. docs/common/compatibility-matrix.json or schemas/compatibility-matrix-1.0.schema.json)"
    },
    "provenance": {
      "type": "object",
      "required": ["author"],
      "properties": {
        "author": { "type": "string" },
        "source_repo": { "type": "string" },
        "signature": { "type": "string" }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "artifact_type",
          "digest",
          "source_ref",
          "license"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "artifact_type": {
            "type": "string",
            "enum": [
              "container_image",
              "helm_chart",
              "k8s_manifest",
              "operator_package",
              "os_package",
              "sbom_attestation"
            ]
          },
          "digest": {
            "type": "string",
            "pattern": "^(sha256|sha512):[a-fA-F0-9]{64,128}$"
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "checksums": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
